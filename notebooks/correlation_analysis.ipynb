{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Correlation Analysis: IC Accessibility & Socioeconomic Indicators\n",
    "\n",
    "This notebook analyzes correlations between IC hub accessibility and various socioeconomic indicators across Swiss municipalities. The outputs are formatted for D3.js visualization integration.\n",
    "\n",
    "**5 Key Correlations:**\n",
    "1. **Accessibility Paradox** - Travel time to IC vs Real Estate prices\n",
    "2. **Employment Hubs** - Employment density vs Accessibility\n",
    "3. **Wealth Gaps** - Average income vs Accessibility\n",
    "4. **Rush Hour Question** - Destinations reachable at different times\n",
    "5. **Density Trade-off** - Population density vs Accessibility (by canton)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "import os\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "os.makedirs('../public/data/correlations', exist_ok=True)\n",
    "print(\"Setup complete.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load and Prepare Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_geojson(path):\n",
    "    with open(path, 'r') as f:\n",
    "        return json.load(f)\n",
    "\n",
    "def geojson_to_df(geojson_data):\n",
    "    features = geojson_data['features']\n",
    "    data = [feat['properties'].copy() for feat in features]\n",
    "    return pd.DataFrame(data)\n",
    "\n",
    "df_income = geojson_to_df(load_geojson('../docs/data/income_levels.geojson'))\n",
    "df_real_estate = geojson_to_df(load_geojson('../docs/data/real_estate_prices.geojson'))\n",
    "df_employment = geojson_to_df(load_geojson('../docs/data/municipal_jobs.geojson'))\n",
    "df_pop = geojson_to_df(load_geojson('../docs/data/population_density.geojson'))\n",
    "df_pt = geojson_to_df(load_geojson('../docs/data/public_transport_share.geojson'))\n",
    "df_acc = geojson_to_df(load_geojson('../docs/data/ptA_IC/accessibility_0900_120min.geojson'))\n",
    "\n",
    "print(f\"Loaded: {len(df_income)} municipalities with income data\")\n",
    "print(f\"Loaded: {len(df_acc)} grid points with accessibility data\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Aggregate accessibility by municipality\n",
    "df_acc_agg = df_acc.groupby('GDENAME').agg({\n",
    "    'min_travel_time_to_ic': ['mean', 'min', 'max'],\n",
    "    'n_destinations_reachable': ['mean', 'min', 'max'],\n",
    "    'nearest_transit_stop_m': 'mean',\n",
    "    'GDENR': 'first',\n",
    "    'KTNAME': 'first',\n",
    "    'KTKZ': 'first'\n",
    "}).reset_index()\n",
    "\n",
    "df_acc_agg.columns = ['name', 'avg_travel_time_ic', 'min_travel_time_ic', 'max_travel_time_ic',\n",
    "                      'avg_destinations', 'min_destinations', 'max_destinations',\n",
    "                      'avg_transit_distance', 'municipality_nr', 'canton', 'canton_code']\n",
    "\n",
    "df_acc_agg = df_acc_agg[df_acc_agg['avg_travel_time_ic'].notna()].reset_index(drop=True)\n",
    "print(f\"Aggregated to {len(df_acc_agg)} municipalities with IC access\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge all datasets\n",
    "df = df_income[['name', 'Avg_Income']].copy()\n",
    "df = df.merge(df_real_estate[['name', 'Price_per_m2']], on='name', how='left')\n",
    "df = df.merge(df_employment[['name', 'Total_Jobs']], on='name', how='left')\n",
    "df = df.merge(df_pop[['name', 'Pop_Density', 'Total_Population']], on='name', how='left')\n",
    "df = df.merge(df_pt[['name', 'PT_Share']], on='name', how='left')\n",
    "df = df.merge(df_acc_agg, on='name', how='inner')\n",
    "\n",
    "df['employment_density'] = (df['Total_Jobs'] / df['Total_Population'] * 1000).fillna(0)\n",
    "\n",
    "print(f\"Final merged dataset: {len(df)} municipalities\")\n",
    "print(f\"Columns: {list(df.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Generate Correlation Data for D3.js"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Scatter: Accessibility Paradox\n",
    "df_scatter = df[['name', 'canton', 'avg_travel_time_ic', 'Price_per_m2', 'Avg_Income']].copy()\n",
    "df_scatter = df_scatter.dropna(subset=['avg_travel_time_ic', 'Price_per_m2'])\n",
    "df_scatter['size'] = (df_scatter['Avg_Income'] / df_scatter['Avg_Income'].max() * 30 + 5).fillna(5)\n",
    "\n",
    "corr = df_scatter['avg_travel_time_ic'].corr(df_scatter['Price_per_m2'])\n",
    "\n",
    "scatter_data = {\n",
    "    'title': 'The Accessibility Paradox',\n",
    "    'description': 'Travel time to nearest IC hub vs Real Estate Price per '',\n",m
    "    'correlation': float(corr),\n",
    "    'data': df_scatter.to_dict('records')\n",
    "}\n",
    "\n",
    "with open('../public/data/correlations/scatter_accessibility_realestate.json', 'w') as f:\n",
    "    json.dump(scatter_data, f)\n",
    "\n",
    "print( Scatter data: {len(df_scatter)} municipalities, r={corr:.3f}\")"f\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Employment: Employment Hubs Connectivity\n",
    "df_emp = df[['name', 'canton', 'canton_code', 'Total_Jobs', 'Total_Population',\n",
    "              'employment_density', 'avg_travel_time_ic', 'Pop_Density', 'Avg_Income']].copy()\n",
    "df_emp = df_emp.dropna(subset=['Total_Jobs', 'avg_travel_time_ic'])\n",
    "\n",
    "canton_emp = df_emp.groupby('canton').agg({\n",
    "    'Total_Jobs': 'sum',\n",
    "    'Total_Population': 'sum',\n",
    "    'avg_travel_time_ic': 'mean',\n",
    "    'employment_density': 'mean',\n",
    "    'name': 'count'\n",
    "}).reset_index()\n",
    "canton_emp.columns = ['canton', 'total_jobs', 'total_population', 'avg_travel_time', 'avg_employment_density', 'municipalities']\n",
    "canton_emp['jobs_per_capita'] = canton_emp['total_jobs'] / canton_emp['total_population'] * 1000\n",
    "\n",
    "corr_emp = df_emp['employment_density'].corr(df_emp['avg_travel_time_ic'])\n",
    "\n",
    "emp_data = {\n",
    "    'title': 'Employment Hubs Connectivity',\n",
    "    'description': 'Employment density vs Accessibility to IC hubs',\n",
    "    'correlation': float(corr_emp),\n",
    "    'municipalities': df_emp.to_dict('records'),\n",
    "    'canton_summary': canton_emp.to_dict('records')\n",
    "}\n",
    "\n",
    "with open('../public/data/correlations/employment_connectivity.json', 'w') as f:\n",
    "    json.dump(emp_data, f)\n",
    "\n",
    "print( Employment data: {len(df_emp)} municipalities, r={corr_emp:.3f}\")"f\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Wealth: Wealth Gaps & Mobility (by canton)\n",
    "df_wealth = df[['canton', 'canton_code', 'Avg_Income', 'avg_travel_time_ic', 'Total_Population']].copy()\n",
    "df_wealth = df_wealth.dropna(subset=['Avg_Income', 'avg_travel_time_ic'])\n",
    "\n",
    "canton_wealth = df_wealth.groupby(['canton', 'canton_code']).agg({\n",
    "    'Avg_Income': 'mean',\n",
    "    'avg_travel_time_ic': 'mean',\n",
    "    'Total_Population': 'sum'\n",
    "}).reset_index()\n",
    "canton_wealth.columns = ['canton', 'canton_code', 'avg_income', 'avg_travel_time', 'population']\n",
    "canton_wealth = canton_wealth.sort_values('avg_income', ascending=False)\n",
    "\n",
    "corr_wealth = canton_wealth['avg_income'].corr(canton_wealth['avg_travel_time'])\n",
    "\n",
    "wealth_data = {\n",
    "    'title': 'Wealth Gaps & Mobility',\n",
    "    'description': 'Average income vs Accessibility to IC hubs by canton',\n",
    "    'correlation': float(corr_wealth),\n",
    "    'data': canton_wealth.to_dict('records')\n",
    "}\n",
    "\n",
    "with open('../public/data/correlations/wealth_gaps_canton.json', 'w') as f:\n",
    "    json.dump(wealth_data, f)\n",
    "\n",
    "print( Wealth data: {len(canton_wealth)} cantons, r={corr_wealth:.3f}\")"f\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Temporal: Rush Hour Question\n",
    "times = ['0900', '1200', '1700', '2200']\n",
    "time_labels = ['09:00', '12:00', '17:00', '22:00']\n",
    "temporal_data_by_time = {}\n",
    "\n",
    "for time_str, time_label in zip(times, time_labels):\n",
    "    acc_file = f'../docs/data/ptA_IC/accessibility_{time_str}_120min.geojson'\n",
    "    if os.path.exists(acc_file):\n",
    "        acc_time = geojson_to_df(load_geojson(acc_file))\n",
    "        agg_time = acc_time.groupby('GDENAME').agg({'n_destinations_reachable': 'mean'}).reset_index()\n",
    "        agg_time.columns = ['name', 'avg_destinations']\n",
    "        agg_time['time'] = time_label\n",
    "        temporal_data_by_time[time_label] = agg_time\n",
    "\n",
    "if temporal_data_by_time:\n",
    "    df_temporal = df[['name', 'canton', 'Total_Population']].copy()\n",
    "    \n",
    "    for time_label, df_time in temporal_data_by_time.items():\n",
    "        df_temporal = df_temporal.merge(\n",
    "            df_time.rename(columns={'avg_destinations': f'destinations_{time_label}'}),\n",
    "            on='name', how='left'\n",
    "        )\n",
    "    \n",
    "    destination_cols = [col for col in df_temporal.columns if col.startswith('destinations_')]\n",
    "    df_temporal['variability'] = df_temporal[destination_cols].std(axis=1)\n",
    "    \n",
    "    temporal_export = {\n",
    "        'title': 'The Rush Hour Question',\n",
    "        'description': 'How accessibility varies across departure times (09:00, 12:00, 17:00, 22:00)',\n",
    "        'times': time_labels,\n",
    "        'data': df_temporal.to_dict('records')\n",
    "    }\n",
    "    \n",
    "    with open('../public/data/correlations/temporal_comparison.json', 'w') as f:\n",
    "        json.dump(temporal_export, f)\n",
    "    \n",
    "    print( Temporal data: {len(df_temporal)} municipalities, 4 time periods\")"f\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Density: Density vs Isolation (faceted by canton)\n",
    "df_density = df[['name', 'canton', 'canton_code', 'Pop_Density', 'avg_travel_time_ic', 'Total_Population']].copy()\n",
    "df_density = df_density.dropna(subset=['Pop_Density', 'avg_travel_time_ic'])\n",
    "\n",
    "canton_pop = df_density.groupby('canton')['Total_Population'].sum().sort_values(ascending=False)\n",
    "major_cantons = canton_pop.head(8).index.tolist()\n",
    "\n",
    "df_density_facet = df_density[df_density['canton'].isin(major_cantons)].copy()\n",
    "\n",
    "canton_correlations = {}\n",
    "for canton in major_cantons:\n",
    "    df_canton = df_density[df_density['canton'] == canton]\n",
    "    corr = df_canton['Pop_Density'].corr(df_canton['avg_travel_time_ic'])\n",
    "    canton_correlations[canton] = float(corr) if not pd.isna(corr) else None\n",
    "\n",
    "density_export = {\n",
    "    'title': 'Density vs Isolation Trade-off',\n",
    "    'description': 'Population density vs Accessibility - faceted by major canton',\n",
    "    'major_cantons': major_cantons,\n",
    "    'correlations_by_canton': canton_correlations,\n",
    "    'data': df_density_facet.to_dict('records')\n",
    "}\n",
    "\n",
    "with open('../public/data/correlations/density_isolation.json', 'w') as f:\n",
    "    json.dump(density_export, f)\n",
    "\n",
    "print( Density data: {len(df_density_facet)} municipalities in {len(major_cantons)} major cantons\")"f\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export full dataset\n",
    "df.to_csv('../public/data/correlations/full_data.csv', index=False)\n",
    "\n",
    "full_data = {\n",
    "    'metadata': {\n",
    "        'municipalities': len(df),\n",
    "        'cantons': df['canton'].nunique(),\n",
    "        'fields': list(df.columns)\n",
    "    },\n",
    "    'data': df.to_dict('records')\n",
    "}\n",
    "\n",
    "with open('../public/data/correlations/full_data.json', 'w') as f:\n",
    "    json.dump(full_data, f)\n",
    "\n",
    "print(f\"\\ All exports complete!\")\n",n
    "print(f\"Dataset: {df.shape[0]} rows  {df.shape[1]} columns\")"
   ]
  }
 ],
